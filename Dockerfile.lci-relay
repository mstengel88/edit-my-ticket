FROM node:20-alpine

WORKDIR /app

RUN npm init -y \
  && npm pkg set type=module \
  && npm install ws

COPY scripts/loadrite-lci-relay.mjs ./scripts/loadrite-lci-relay.mjs
COPY scripts/loadrite-completion-time.mjs ./scripts/loadrite-completion-time.mjs

CMD ["node", "scripts/loadrite-lci-relay.mjs"]
